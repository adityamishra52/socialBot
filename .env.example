# Copy to .env for local runs, and set the same names on Vercel (Project > Settings > Environment Variables).
# Never commit real values.

# --- Required ---
# MongoDB connection string (a free MongoDB Atlas cluster works). In Atlas > Network Access allow 0.0.0.0/0,
# because Vercel functions have no fixed IP address.
MONGODB_URI=
# Database name. Default: social_autopost
MONGODB_DB=
# Random values: 32+ characters each. Changing TOKEN_ENCRYPTION_KEY makes saved access tokens unreadable.
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
# Unlocks /admin. At least 6 characters.
ADMIN_PIN=
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gemini (lite models only, to keep costs low) ---
# Default: gemini-2.5-flash-lite, then other flash-lite models if Google retires one. A name without "lite" is ignored.
GEMINI_MODEL=
# Voiceover for Site to Reel. Default: gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=
# AI image generation has no lite model, so it is OFF unless you name an image model here (it costs more).
GEMINI_IMAGE_MODEL=
# "free" records AI cost as $0 (for a free-tier key).
GEMINI_BILLING_TIER=

# --- Scheduled work (Autopost bots, email campaigns, clean-up) ---
# Vercel Cron calls /api/cron/tick with this secret. On the Hobby plan cron runs once a day; for more frequent
# runs, point a free service such as cron-job.org at https://YOUR-SITE/api/cron/tick?key=CRON_SECRET every 10 minutes.
CRON_SECRET=

# --- Email (optional): SMTP for account emails and bulk email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DAILY_LIMIT=450
EMAIL_SEND_DELAY_SECONDS=1.5

# --- LinkedIn (optional shared app; users can also save their own in Settings) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Default: https://YOUR-SITE/api/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=202609
META_GRAPH_VERSION=v26.0

# --- Optional ---
# Your site's address, if links in emails show the wrong host. Example: https://your-app.vercel.app
PUBLIC_URL=
# Days to keep posts, reels, campaigns and AI activity (default 7), and manuscripts/books (default 30).
HISTORY_DAYS=7
MANUSCRIPT_DAYS=30
# Optional keys that raise free research quotas.
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
OPENALEX_EMAIL=
